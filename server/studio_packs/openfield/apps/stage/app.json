  "native": "stage",
  "page": "stage",
  "summary": "Block boxes, figures, walls or your own 3D models, set a lens and a camera path; LTX-2.5 Layout-to-Render films a real shot that moves exactly like the blocking.",
  "requires_nodes": [
    "LTXICLoRALoaderModelOnly",
    "LTXAddVideoICLoRAGuide",
    "LTXVCropGuides",
    "LoadVideo",
    "GetVideoComponents"
  ],
  "inputs": [
    {
      "id": "clay",
      "type": "video",
      "label": "Clay blocking clip",
      "required": true,
      "help": "Made by the Stage editor (Open Stage). Any grey-box clip works too; it is fitted to a 64-pixel grid."
    },
    {
      "id": "prompt",
      "type": "textarea",
      "label": "What the shot is",
      "required": true,
      "default": "A woman in a long dark coat stands in a rain-soaked night alley between a wooden crate and a concrete pillar, neon light on wet brick."
    },
    {
      "id": "look",
      "type": "image",
      "label": "Look frame (optional)",
      "help": "The first frame's art direction. Empty = FLUX Klein paints it over the clay's first frame, keeping every object in place."
    },
    {
      "id": "era",
      "type": "select",
      "label": "Era look",
      "default": 0,
      "options": [
        {
          "value": 0,
