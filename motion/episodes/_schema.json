{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mir-explained/episode.schema.json",
  "title": "MIR EXPLAINED episode",
  "description": "Written by server/explainer.py (script stage). Visual types = the generic Remotion engine's vocabulary.",
  "type": "object",
  "required": [
    "meta",
    "voice",
    "music",
    "assets",
    "chapters",
    "beats",
    "shorts",
    "youtube",
    "thumbnail",
    "ref_urls"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "slug",
        "title",
        "series",
        "asOf",
        "sources"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$"
        },
        "title": {
          "type": "string"
        },
        "series": {
          "const": "MIR EXPLAINED"
        },
        "asOf": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "voice": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "enum": [
            "af_bella",
            "af_heart",
            "af_nicole",
            "af_sky",
            "bf_emma",
            "am_michael",
            "am_fenrir",
            "bm_george"
          ]
        },
        "speed": {
          "type": "number"
        }
      }
    },
    "music": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "fromChapter",
          "prompt",
          "seconds"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "fromChapter": {
            "type": "integer"
          },
          "prompt": {
            "type": "string"
          },
          "seconds": {
            "type": "number"
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {
        "type": "object",
        "required": [
          "model",
          "prompt"
        ],
        "properties": {
          "model": {
            "enum": [
              "qimg",
              "h3"
            ]
          },
          "prompt": {
            "type": "string"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "from": {
            "type": "string"
          },
          "seconds": {
            "type": "number"
          }
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "n",
          "title"
        ],
        "properties": {
          "n": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "ch",
          "mode",
          "v",
          "cap"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "ch": {
            "type": "integer"
          },
          "mode": {
            "enum": [
              "studio",
              "hud",
              "card",
              "photo",
              "brand",
              "end"
            ]
          },
          "plate": {
            "type": "string"
          },
          "photo": {
            "type": "string"
          },
          "cap": {
            "type": "string"
          },
          "say": {
            "type": "string"
          },
          "pad": {
            "type": "number"
          },
          "v": {
            "oneOf": [
              {
                "$ref": "#/$defs/v_plate"
              },
              {
                "$ref": "#/$defs/v_bignum"
              },
              {
                "$ref": "#/$defs/v_chapter"
              },
              {
                "$ref": "#/$defs/v_brand"
              },
              {
                "$ref": "#/$defs/v_photo"
              },
              {
                "$ref": "#/$defs/v_spec"
              },
              {
                "$ref": "#/$defs/v_gbars"
              },
              {
                "$ref": "#/$defs/v_trims"
              },
              {
                "$ref": "#/$defs/v_questions"
              },
              {
                "$ref": "#/$defs/v_recap"
              },
              {
                "$ref": "#/$defs/v_formula"
              },
              {
                "$ref": "#/$defs/v_midroll"
              },
              {
                "$ref": "#/$defs/v_endcard"
              },
              {
                "$ref": "#/$defs/v_timeline"
              },
              {
                "$ref": "#/$defs/v_compare"
              },
              {
                "$ref": "#/$defs/v_diagram"
              }
            ]
          }
        }
      }
    },
    "shorts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "ids",
          "hook",
          "title"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "hook": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "youtube": {
      "type": "object",
      "required": [
        "title",
        "description",
        "tags",
        "pinned_comment"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 70
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string"
          }
        },
        "pinned_comment": {
          "type": "string"
        }
      }
    },
    "thumbnail": {
      "type": "object",
      "required": [
        "plate",
        "number",
        "unit",
        "hook"
      ],
      "properties": {
        "plate": {
          "type": "string"
        },
        "number": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "hook": {
          "type": "string"
        }
      }
    },
    "ref_urls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "source",
          "use"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "source": {
            "type": "string"
          },
          "use": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "v_plate": {
      "type": "object",
      "required": [
        "c"
      ],
      "properties": {
        "c": {
          "const": "plate"
        }
      }
    },
    "v_chapter": {
      "type": "object",
      "required": [
        "c"
      ],
      "properties": {
        "c": {
          "const": "chapter"
        }
      }
    },
    "v_brand": {
      "type": "object",
      "required": [
        "c"
      ],
      "properties": {
        "c": {
          "const": "brand"
        }
      }
    },
    "v_midroll": {
      "type": "object",
      "required": [
        "c"
      ],
      "properties": {
        "c": {
          "const": "midroll"
        }
      }
    },
    "v_endcard": {
      "type": "object",
      "required": [
        "c"
      ],
      "properties": {
        "c": {
          "const": "endcard"
        }
      }
    },
    "v_bignum": {
      "type": "object",
      "required": [
        "c",
        "value",
        "label"
      ],
      "properties": {
        "c": {
          "const": "bignum"
        },
        "value": {
          "type": "number"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "unit": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "sub": {
          "type": "string"
        }
      }
    },
    "v_photo": {
      "type": "object",
      "required": [
        "c",
        "credit"
      ],
      "properties": {
        "c": {
          "const": "photo"
        },
        "credit": {
          "type": "string"
        }
      }
    },
    "v_spec": {
      "type": "object",
      "required": [
        "c",
        "title",
        "rows"
      ],
      "properties": {
        "c": {
          "const": "spec"
        },
        "title": {
          "type": "string"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3
          }
        }
      }
    },
    "v_gbars": {
      "type": "object",
      "required": [
        "c",
        "title",
        "bars"
      ],
      "properties": {
        "c": {
          "const": "gbars"
        },
        "title": {
          "type": "string"
        },
        "bars": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3
          }
        },
        "max": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "stamp": {
          "type": "string"
        }
      }
    },
    "v_trims": {
      "type": "object",
      "required": [
        "c",
        "cards"
      ],
      "properties": {
        "c": {
          "const": "trims"
        },
        "cards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "price": {
                "type": "string"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "v_questions": {
      "type": "object",
      "required": [
        "c",
        "items"
      ],
      "properties": {
        "c": {
          "const": "questions"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "v_recap": {
      "type": "object",
      "required": [
        "c",
        "items"
      ],
      "properties": {
        "c": {
          "const": "recap"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "v_formula": {
      "type": "object",
      "required": [
        "c",
        "lines"
      ],
      "properties": {
        "c": {
          "const": "formula"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "note": {
          "type": "string"
        },
        "stamp": {
          "type": "string"
        }
      }
    },
    "v_timeline": {
      "type": "object",
      "required": [
        "c",
        "events"
      ],
      "properties": {
        "c": {
          "const": "timeline"
        },
        "events": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "at",
              "label"
            ],
            "properties": {
              "at": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "past",
                  "now",
                  "future",
                  "claim"
                ]
              }
            }
          }
        }
      }
    },
    "v_compare": {
      "type": "object",
      "required": [
        "c",
        "rows"
      ],
      "properties": {
        "c": {
          "const": "compare"
        },
        "left": {
          "type": "string"
        },
        "right": {
          "type": "string"
        },
        "rows": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    },
    "v_diagram": {
      "type": "object",
      "required": [
        "c",
        "plate",
        "callouts"
      ],
      "properties": {
        "c": {
          "const": "diagram"
        },
        "plate": {
          "type": "string"
        },
        "callouts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "x",
              "y",
              "title"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "title": {
                "type": "string"
              },
              "sub": {
                "type": "string"
              },
              "color": {
                "enum": [
                  "cyan",
                  "amber",
                  "ink",
                  "red",
                  "green"
                ]
              }
            }
          }
        }
      }
    }
  }
}